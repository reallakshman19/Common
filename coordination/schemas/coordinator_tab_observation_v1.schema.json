{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoordinatorTabObservationV1",
  "description": "Side-effect-free typed projection of the exact 10-column watch.ps1 row output with composite binding envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tab",
    "status",
    "aim",
    "plan",
    "ac",
    "ci",
    "meter",
    "due",
    "checked",
    "next",
    "tab_position",
    "chat_id",
    "binding_generation",
    "observed_at_utc",
    "probe_status"
  ],
  "properties": {
    "tab": {
      "type": "string",
      "description": "Column 1: Tab string from coordinator"
    },
    "status": {
      "type": "string",
      "description": "Column 2: Exact Status string from coordinator"
    },
    "aim": {
      "type": "string",
      "description": "Column 3: Aim label string"
    },
    "plan": {
      "type": "string",
      "description": "Column 4: Plan revision string"
    },
    "ac": {
      "type": "string",
      "description": "Column 5: Acceptance criteria status"
    },
    "ci": {
      "type": "string",
      "description": "Column 6: Exact CI check status"
    },
    "meter": {
      "type": "string",
      "description": "Column 7: Progress meter string"
    },
    "due": {
      "type": "string",
      "description": "Column 8: Due date / milestone string"
    },
    "checked": {
      "type": "string",
      "description": "Column 9: Checked freshness string"
    },
    "next": {
      "type": "string",
      "description": "Column 10: Next action obligation string"
    },
    "tab_position": {
      "type": "string",
      "description": "Numeric tab position (e.g. '1', '2', '3')"
    },
    "chat_id": {
      "type": "string",
      "description": "Chat identifier from cyclestate map"
    },
    "binding_generation": {
      "type": "integer",
      "minimum": 1,
      "description": "Successive generation number for this chat binding"
    },
    "assignment_id": {
      "type": ["string", "null"],
      "description": "Resolved assignment ID if mapped, or null if unassigned"
    },
    "work_id": {
      "type": ["string", "null"],
      "description": "Resolved Work ID if mapped, or null if unassigned"
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the observation row"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy alias for observed_at_utc"
    },
    "last_probe_at_utc": {
      "type": ["string", "null"],
      "description": "Timestamp of the last live coordinator probe"
    },
    "probe_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "TIMEOUT",
        "LOADFAIL",
        "NOBOX",
        "UNUSUAL",
        "ERROR",
        "NEVER_PROBED",
        "UNKNOWN"
      ],
      "description": "Verbatim status result of the last probe"
    },
    "liveness": {
      "type": "string",
      "enum": ["ALIVE", "STALE", "UNKNOWN"],
      "description": "Calculated probe freshness against 2x Cycle threshold"
    },
    "coordinator_liveness": {
      "type": "string",
      "enum": ["ALIVE", "STALE", "STOPPED", "UNKNOWN"],
      "description": "Legacy alias for liveness"
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Any identity or binding conflict flags"
    }
  }
}
