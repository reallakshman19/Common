{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reallakshman19/Common/blob/main/skills/engineering-pr-delivery-v3.5/schemas/buddy-runner-v1.5.schema.json",
  "title": "BuddyRunner v1.5 purpose reconstruction request (not an authority credential)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "mode",
    "case"
  ],
  "properties": {
    "schema_version": {
      "const": "buddy-runner-v1.5"
    },
    "stage": {
      "enum": [
        "STAGE1",
        "STAGE2"
      ]
    },
    "mode": {
      "const": "OPEN_SOURCE_PURPOSE_RECONSTRUCTION"
    },
    "case": {
      "$ref": "#/$defs/case"
    },
    "stage1_evidence": {
      "$ref": "#/$defs/stage1_evidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "STAGE1"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "not": {
          "required": [
            "stage1_evidence"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "STAGE2"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "stage1_evidence"
        ]
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "current_issue",
        "parent_issue",
        "roadmap_refs",
        "inherited_commit",
        "owner_source_grade",
        "objective_hint",
        "candidate_pr_refs"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "current_issue": {
          "$ref": "#/$defs/uri"
        },
        "parent_issue": {
          "$ref": "#/$defs/uri"
        },
        "roadmap_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uri"
          }
        },
        "inherited_commit": {
          "$ref": "#/$defs/sha"
        },
        "candidate_pr_refs": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uri"
          }
        },
        "owner_source_grade": {
          "enum": [
            "DIRECT_OWNER_VERIFIED",
            "MIRRORED_UNVERIFIED",
            "UNKNOWN"
          ]
        },
        "owner_intent_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/uri"
            },
            {
              "const": "UNKNOWN"
            }
          ]
        },
        "objective_hint": {
          "type": "string",
          "minLength": 10,
          "maxLength": 3000,
          "description": "Context hint, not an authenticated Owner quote or binding implementation plan"
        },
        "scope_constraints": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          }
        },
        "known_competing_paths": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 350
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "stage1_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_url",
        "artifact_digest",
        "assessed_commit",
        "evidence_grade"
      ],
      "properties": {
        "publication_url": {
          "$ref": "#/$defs/uri"
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256"
        },
        "assessed_commit": {
          "$ref": "#/$defs/sha"
        },
        "evidence_grade": {
          "enum": [
            "AGENT_CLAIM_ONLY",
            "PROVIDER_READBACK_OBSERVED"
          ]
        },
        "stage1_purpose_summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 3000
        }
      }
    }
  }
}
