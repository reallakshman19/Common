{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "independent-review.result/v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "author_relation": {
          "type": "string",
          "enum": [
            "SAME",
            "DISTINCT",
            "UNKNOWN"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "author_relation",
        "basis"
      ],
      "additionalProperties": false
    },
    "review_type": {
      "type": "string",
      "enum": [
        "SELF_REVIEW",
        "SEPARATE_REVIEW",
        "UNESTABLISHED"
      ]
    },
    "independence": {
      "type": "object",
      "properties": {
        "context": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "FRESH",
                "EXPOSED",
                "UNKNOWN"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "additionalProperties": false
        },
        "expectation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "INDEPENDENT",
                "SHARED",
                "UNKNOWN"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "additionalProperties": false
        },
        "method": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ALTERNATIVE",
                "REPLAY",
                "NOT_RUN",
                "UNKNOWN"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "RERUN",
                "INSPECTED_ONLY",
                "REPORTED_ONLY",
                "NOT_RUN",
                "UNKNOWN"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "additionalProperties": false
        },
        "lineage": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ASSESSED",
                "SHARED_RISK",
                "UNKNOWN"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "context",
        "expectation",
        "method",
        "execution",
        "lineage"
      ],
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "EXECUTED",
              "INSPECTED",
              "DERIVED",
              "SIMULATED",
              "REPORTED",
              "NOT_RUN"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "candidate_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "local_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "source_refs",
          "candidate_refs",
          "limits"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "claim_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "CONTRADICTED",
              "INCONCLUSIVE",
              "NOT_RUN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "claim_id",
          "status",
          "evidence_refs",
          "reason",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "OPEN",
              "ADDRESSED",
              "ADVISORY"
            ]
          }
        },
        "required": [
          "id",
          "claim_refs",
          "evidence_refs",
          "description",
          "impact",
          "scope",
          "disposition"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "coverage": {
      "type": "object",
      "properties": {
        "assessed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "not_assessed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "assessed",
        "not_assessed"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "PASS",
            "NEEDS_WORK",
            "FAIL",
            "INCONCLUSIVE"
          ]
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "claim_refs",
        "rationale"
      ],
      "additionalProperties": false
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "native_report": {
      "type": "object",
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "locator"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "object"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "adapter",
          "locator",
          "identity"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "case_digest",
    "run_id",
    "reviewer",
    "review_type",
    "independence",
    "candidates",
    "evidence",
    "claim_results",
    "findings",
    "coverage",
    "verdict",
    "next_action"
  ],
  "additionalProperties": false,
  "$defs": {
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "locator",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:common:independent-review:review-result:v1"
}
