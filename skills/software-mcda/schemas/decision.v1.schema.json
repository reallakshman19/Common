{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software MCDA decision v1",
  "type": "object",
  "required": [
    "schema",
    "criteria",
    "options"
  ],
  "properties": {
    "schema": {
      "const": "software-mcda.decision/v1"
    },
    "title": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "scores"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scores": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            }
          },
          "evidence_level": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "passes"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "passes": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
