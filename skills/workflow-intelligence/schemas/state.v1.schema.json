{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Intelligence state v1",
  "type": "object",
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "workflow-intelligence.state/v1"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "semantic_sha256",
          "observation"
        ],
        "properties": {
          "semantic_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observation": {
            "type": "object"
          }
        }
      }
    }
  }
}
