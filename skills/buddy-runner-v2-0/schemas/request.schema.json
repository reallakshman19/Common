{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuddyRunner v2 request (untrusted declarations, not authority)",
  "type": "object",
  "required": [
    "version",
    "id",
    "mode",
    "phase",
    "continuation",
    "actor",
    "incoming",
    "owner",
    "repository",
    "issue",
    "assessed_commit",
    "assignment",
    "profile"
  ],
  "properties": {
    "version": {
      "const": "buddy-runner/v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "ASSISTED",
        "RECOVERY",
        "ONBOARD"
      ]
    },
    "phase": {
      "enum": [
        "1a",
        "1b",
        "2",
        "RECOVERY"
      ]
    },
    "continuation": {
      "enum": [
        "CONTINUE_AUTHORIZED_TASK",
        "AWAIT_OWNER_TASK"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "incoming": {
      "type": "string",
      "minLength": 1
    },
    "outgoing": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "issue": {
      "type": "string",
      "format": "uri"
    },
    "assessed_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "deliverable",
        "inputs",
        "boundaries",
        "success",
        "uncertainty",
        "continuation"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "continuation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "description": "Supplied runtime observations; only a real host can establish their provenance."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "ONBOARD"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "continuation": {
            "const": "AWAIT_OWNER_TASK"
          }
        }
      }
    }
  ]
}
