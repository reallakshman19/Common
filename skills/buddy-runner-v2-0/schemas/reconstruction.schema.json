{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuddyRunner v2 reconstruction (structural, never machine verified)",
  "type": "object",
  "required": [
    "takeover_id",
    "actor",
    "phase",
    "assessed_commit",
    "sections",
    "route_challenge",
    "choices",
    "chosen",
    "rationale",
    "next_action",
    "findings"
  ],
  "properties": {
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "1b",
        "2",
        "RECOVERY"
      ]
    },
    "assessed_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sections": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "state",
          "refs"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "VERIFIED",
              "REPORTED",
              "UNKNOWN",
              "NOT_RUN"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "UNKNOWN",
                    "NOT_RUN"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "refs": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "route_challenge": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "benefit",
          "route",
          "evidence",
          "effort",
          "risk",
          "falsifier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "KEEP",
              "IMPROVE",
              "VERIFY_FIRST",
              "OWNER_DECISION_REQUIRED"
            ]
          },
          "benefit": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "effort": {
            "enum": [
              "XS",
              "S",
              "M",
              "L"
            ]
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "falsifier": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "chosen": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "impact",
          "action",
          "refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "DRIFT",
              "DEFECT",
              "IMPROVEMENT",
              "INPUT_GAP",
              "DECISION_CONFLICT"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "introduced": {
            "type": "boolean"
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "introduced"
              ],
              "properties": {
                "introduced": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "before",
                "after"
              ]
            }
          }
        ]
      }
    },
    "dispositions": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["decision", "reason", "refs"],
        "properties": {
          "decision": {"enum": ["RETAIN", "RESOLVED", "SUPERSEDED", "PARK"]},
          "reason": {"type": "string", "minLength": 1},
          "refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "takeover_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
